# Supabase project URL (base URL only; no /rest/v1 suffix)
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-side secret key. Do not expose this to browser code or NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Browser-safe publishable key used only to establish Realtime subscriptions.
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
